    "ai": "^4.1.60",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
