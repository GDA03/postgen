    "@ai-sdk/openai": "^1.2.1",
    "@openrouter/ai-sdk-provider": "^0.7.5",
    "@postgen/shared": "workspace:*",
    "ai": "^4.1.60",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
